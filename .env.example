# Backend database
DB_URL=jdbc:mysql://localhost:3306/smart_travel
DB_USERNAME=root
DB_PASSWORD=root

# JPA / logging
SHOW_SQL=false

# CORS for browser-runnable frontend
APP_CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000

# External services
UNSPLASH_API_KEY=
OPENROUTER_API_KEY=
PLANNER_AI_ENABLED=true
PLANNER_AI_API_URL=https://openrouter.ai/api/v1/chat/completions
PLANNER_AI_MODEL=openai/gpt-4o-mini
